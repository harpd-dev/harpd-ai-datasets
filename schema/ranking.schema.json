{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/harpd-dev/harpd-ai-datasets/main/schema/ranking.schema.json",
  "title": "Harpd Rank Product",
  "description": "A single ranked product record on the Harpd Rank board. Published under CC BY 4.0, attribution Harpd (https://harpd.com).",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "slug", "category", "rank", "updatedAt"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "category": { "type": "string" },
    "categoryName": { "type": "string" },
    "rank": { "type": ["integer", "null"] },
    "rankPoints": { "type": ["number", "null"] },
    "verified": { "type": ["boolean", "null"] },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
