{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harpd.com/data/schema/dataset-truth.schema.json",
  "title": "DATASET_TRUTH",
  "description": "Single source of truth for Harpd AI Datasets. Every count printed by the website, API, GitHub READMEs, research and schema files MUST derive from groundTruth in this file. Generated by scripts/generate-truth.mjs — never hand-edited.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "canonical", "license", "groundTruth", "derivedArtifacts", "artifacts", "checksums"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "format": "uri" },
    "canonical": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "attribution": { "type": "string" },
    "groundTruth": {
      "type": "object",
      "required": ["products", "categories", "rankBoards"],
      "additionalProperties": false,
      "properties": {
        "products": { "type": "integer", "minimum": 0 },
        "categories": { "type": "integer", "minimum": 0 },
        "rankBoards": { "type": "integer", "minimum": 0 },
        "discoveryTotal": { "type": ["integer", "null"], "minimum": 0 },
        "discoveryOnRankBoard": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "derivedArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "field", "mustEqual"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "field": { "type": "string" },
          "mustEqual": { "type": "string", "enum": ["groundTruth.products"] }
        }
      }
    },
    "documentedCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "sha256"],
        "properties": {
          "file": { "type": "string" },
          "count": { "type": ["integer", "null"], "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "derivedFrom": { "type": "string" }
        }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "notes": { "type": "string" }
  }
}
